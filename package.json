{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "boxd",
  "title": "boxd",
  "description": "Manage boxd machines, right at your fingertips.",
  "icon": "extension-icon.png",
  "author": "NabhagMotivaras",
  "platforms": [
    "Windows",
    "macOS"
  ],
  "categories": [
    "Developer Tools"
  ],
  "license": "MIT",
  "preferences": [
    {
      "name": "apiKey",
      "type": "password",
      "required": true,
      "title": "API Key",
      "description": "Your boxd API key.",
      "placeholder": "bxd_..."
    },
    {
      "name": "apiBaseUrl",
      "type": "textfield",
      "required": false,
      "default": "https://boxd.sh:9443",
      "title": "API Base URL",
      "description": "The base URL for the boxd API.",
      "placeholder": "https://boxd.sh:9443"
    }
  ],
  "commands": [
    {
      "name": "list-machines",
      "title": "List Machines",
      "subtitle": "boxd",
      "description": "Browse, access, and manage your boxd machines.",
      "mode": "view"
    },
    {
      "name": "create-machine",
      "title": "Create Machine",
      "subtitle": "boxd",
      "description": "Create a boxd machine.",
      "mode": "view"
    }
  ],
  "tools": [],
  "dependencies": {
    "@boxd-sh/sdk": "^0.3.5",
    "@raycast/api": "^2.13.1",
    "@raycast/utils": "^2.2.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "build": "ray build",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "publish": "npx @raycast/api@latest publish"
  }
}
